# Database
DATABASE_URL=postgresql://orchestryx:password@localhost:5432/orchestryx
DB_SSL_MODE=disable
SQL_ECHO=false

# AWS core
ORCHESTRYX_ENV=dev
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012

# Cognito
COGNITO_USER_POOL_ID=eu-central-1_example
COGNITO_APP_CLIENT_ID=exampleclientid
COGNITO_JWKS_TTL_SECONDS=3600

# SQS / Celery
SQS_PROVISION_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/orchestryx-provision-lab
SQS_DESTROY_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/orchestryx-destroy-lab
PROVISION_QUEUE=orchestryx-provision-lab
DESTROY_QUEUE=orchestryx-destroy-lab

# API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ECS Fargate lab runtime
LAB_RUNTIME_ENABLED=false
LAB_MAX_ACTIVE_PER_USER=2
LAB_PROVISION_TIMEOUT_SECONDS=900
LAB_STARTUP_RETRY_SECONDS=30
LAB_CLEANUP_STUCK_AFTER_SECONDS=1200
LAB_RETENTION_DAYS=14
LAB_ECS_CLUSTER=orchestryx
LAB_ECS_SUBNET_IDS=subnet-aaaaaaaa,subnet-bbbbbbbb
LAB_ECS_SECURITY_GROUP_IDS=sg-aaaaaaaa
LAB_ECS_ASSIGN_PUBLIC_IP=false
LAB_ECS_PUBLIC_ACCESS_ENABLED=false
LAB_ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/orchestryx-ecs-execution-role
LAB_ECS_TASK_ROLE_ARN=
LAB_ECS_LOG_GROUP=/ecs/orchestryx-labs
LAB_ECS_LOG_STREAM_PREFIX=lab
LAB_ECS_CPU=512
LAB_ECS_MEMORY_MIB=1024
ORCHESTRYX_WIREGUARD_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
ORCHESTRYX_WIREGUARD_SECURITY_GROUP_ID=sg-wireguard

# Shared WireGuard config for private Fargate lab access.
# Store the full config in Secrets Manager and set LAB_VPN_CONFIG_SECRET_ID,
# or set LAB_VPN_CONFIG_INLINE for local-only testing. The config must route
# the lab VPC CIDR, for example:
# AllowedIPs = 10.8.0.0/24, 172.31.0.0/16
LAB_VPN_CONFIG_SECRET_ID=
LAB_VPN_CONFIG_INLINE=

# AWS monitoring
AWS_ECS_CLUSTER=orchestryx
AWS_API_SERVICE=orchestryx-api-service
AWS_WORKER_SERVICE=orchestryx-worker-service
AWS_AURORA_CLUSTER=orchestryx-db
AWS_COGNITO_POOL_ID=
AWS_API_LOG_GROUP=/ecs/orchestryx-api
AWS_WORKER_LOG_GROUP=/ecs/orchestryx-worker
AWS_ECR_API_REPOSITORY=orchestryx-api
AWS_ECR_WORKER_REPOSITORY=orchestryx-worker
# Required for per-lab security group creation (create_per_lab_security_group).
# In ECS tasks this is injected automatically by the CDK task definition.
# For local dev, set this directly or set ORCHESTRYX_VPC_ID (exported by
# export_env.py into .env.dev.generated) — config.py treats them as equivalent.
AWS_VPC_ID=vpc-xxxxxxxx
ORCHESTRYX_VPC_ID=
