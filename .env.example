DATABASE_URL=postgresql://orchestryx:password@localhost:5432/orchestryx
DB_SSL_MODE=disable
SQL_ECHO=false

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012
COGNITO_USER_POOL_ID=eu-central-1_example
COGNITO_APP_CLIENT_ID=exampleclientid

SQS_PROVISION_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/orchestryx-provision-lab
SQS_DESTROY_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/orchestryx-destroy-lab
PROVISION_QUEUE=orchestryx-provision-lab
DESTROY_QUEUE=orchestryx-destroy-lab

CORS_ALLOWED_ORIGINS=http://localhost:3000
CDK_INFRA_PATH=infra
WG_DNS=1.1.1.1

LAB_MAX_ACTIVE_PER_USER=2
LAB_PROVISION_TIMEOUT_SECONDS=900
LAB_STARTUP_RETRY_SECONDS=30
LAB_CLEANUP_STUCK_AFTER_SECONDS=1200
LAB_RETENTION_DAYS=14

AWS_ECS_CLUSTER=orchestryx
AWS_API_SERVICE=orchestryx-api-service
AWS_WORKER_SERVICE=orchestryx-worker-service
AWS_AURORA_CLUSTER=orchestryx-db
AWS_COGNITO_POOL_ID=eu-central-1_example
AWS_API_LOG_GROUP=/ecs/orchestryx-api
AWS_WORKER_LOG_GROUP=/ecs/orchestryx-worker
AWS_ECR_API_REPOSITORY=orchestryx-api
AWS_ECR_WORKER_REPOSITORY=orchestryx-worker
AWS_VPC_ID=
