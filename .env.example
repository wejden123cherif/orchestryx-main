# Orchestryx backend environment
# Copy this file to .env and fill in only values that are intentionally blank.
# Production runs on AWS Aurora Serverless v2; Docker Compose can use its local
# Postgres service for isolated development.

# Database
# Local raw-uvicorn development against a local Postgres instance.
DATABASE_URL=postgresql://orchestryx:password@localhost:5432/orchestryx

# Docker Compose overrides DATABASE_URL inside the api and worker containers to:
# postgresql://orchestryx:password@db:5432/orchestryx

# Production Aurora Serverless v2 database URL. Uncomment for production-style
# runs from a network that can reach the Aurora cluster.
# DATABASE_URL=postgresql://orchestryx:${AURORA_DB_PASSWORD}@orchestryx-db.cluster-cz86ciucmlhr.eu-central-1.rds.amazonaws.com:5432/orchestryx

# Keep false unless debugging SQL locally. SQL logging can expose query data.
SQL_ECHO=false

# DB_SSL_MODE=disable        # local development
# DB_SSL_MODE=require        # Aurora production
DB_SSL_MODE=disable

# AWS region and account
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=254076817005

# Cognito authentication
COGNITO_USER_POOL_ID=eu-central-1_FCduBIpFa
COGNITO_APP_CLIENT_ID=

# SQS queues used by Celery workers
PROVISION_QUEUE=orchestryx-provision-lab
DESTROY_QUEUE=orchestryx-destroy-lab
SQS_PROVISION_URL=https://sqs.eu-central-1.amazonaws.com/254076817005/orchestryx-provision-lab
SQS_DESTROY_URL=https://sqs.eu-central-1.amazonaws.com/254076817005/orchestryx-destroy-lab

# API
# Comma-separated list if multiple frontend origins are needed.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CDK / lab provisioning
# Raw uvicorn/worker from the repo root can use infra.
# Docker/ECS worker images copy infra into /app/infra, but /app is the workdir.
CDK_INFRA_PATH=infra

# WireGuard client configuration generated for lab access
WG_DNS=1.1.1.1
