FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        wireguard-tools \
    && npm install -g aws-cdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--pool=solo", "-I", "app.workers.provision,app.workers.destroy"]
