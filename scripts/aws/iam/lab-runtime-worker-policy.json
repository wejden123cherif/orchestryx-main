{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageEphemeralLabTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecs:DescribeTasks",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectLabTaskNetworking",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeNetworkInterfaces"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadAndPrepareLabLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassLabRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::254076817005:role/orchestryx-ecs-execution-role",
        "arn:aws:iam::254076817005:role/orchestryx-lab-task-role"
      ]
    }
  ]
}
