{
  "cluster": "orchestryx",
  "region": "eu-central-1",
  "loadBalancer": {
    "name": "orchestryx-api-alb",
    "scheme": "internet-facing",
    "listener": {
      "protocol": "HTTP",
      "port": 80
    },
    "targetGroup": {
      "name": "orchestryx-api-tg",
      "protocol": "HTTP",
      "port": 8000,
      "targetType": "ip",
      "healthCheckPath": "/health"
    }
  },
  "services": [
    {
      "name": "orchestryx-api-service",
      "taskDefinitionFamily": "orchestryx-api",
      "taskDefinitionFile": "scripts/aws/task-definitions/api-task.json",
      "desiredCount": 1,
      "launchType": "FARGATE",
      "networkConfiguration": {
        "subnets": [
          "subnet-09b0a64b46e90bf03",
          "subnet-0f3460c06ddf5ecc9"
        ],
        "securityGroups": [
          "sg-0205b75f583ebfa25"
        ],
        "assignPublicIp": "ENABLED"
      },
      "loadBalancers": {
        "targetGroupName": "orchestryx-api-tg",
        "containerName": "orchestryx-api",
        "containerPort": 8000
      }
    },
    {
      "name": "orchestryx-worker-service",
      "taskDefinitionFamily": "orchestryx-worker",
      "taskDefinitionFile": "scripts/aws/task-definitions/worker-task.json",
      "desiredCount": 1,
      "launchType": "FARGATE",
      "networkConfiguration": {
        "subnets": [
          "subnet-09b0a64b46e90bf03",
          "subnet-0f3460c06ddf5ecc9"
        ],
        "securityGroups": [
          "sg-0db089ffb994e8272"
        ],
        "assignPublicIp": "ENABLED"
      }
    }
  ]
}
