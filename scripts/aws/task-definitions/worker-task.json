{
  "family": "orchestryx-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::254076817005:role/orchestryx-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::254076817005:role/orchestryx-worker-task-role",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "orchestryx-worker",
      "image": "254076817005.dkr.ecr.eu-central-1.amazonaws.com/orchestryx-worker:latest",
      "essential": true,
      "command": [
        "celery",
        "-A",
        "workers.celery_app",
        "worker",
        "--loglevel=info",
        "--pool=solo",
        "-Q",
        "orchestryx-provision-lab,orchestryx-destroy-lab",
        "-I",
        "workers.provision,workers.destroy"
      ],
      "environment": [
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "LAB_RUNTIME_ENABLED",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:DATABASE_URL::"
        },
        {
          "name": "SQL_ECHO",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:SQL_ECHO::"
        },
        {
          "name": "DB_SSL_MODE",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:DB_SSL_MODE::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:AWS_REGION::"
        },
        {
          "name": "AWS_ACCOUNT_ID",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:AWS_ACCOUNT_ID::"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:COGNITO_USER_POOL_ID::"
        },
        {
          "name": "COGNITO_APP_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:COGNITO_APP_CLIENT_ID::"
        },
        {
          "name": "PROVISION_QUEUE",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:PROVISION_QUEUE::"
        },
        {
          "name": "DESTROY_QUEUE",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:DESTROY_QUEUE::"
        },
        {
          "name": "SQS_PROVISION_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:SQS_PROVISION_URL::"
        },
        {
          "name": "SQS_DESTROY_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:SQS_DESTROY_URL::"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:254076817005:secret:orchestryx/api/env-J7WB6D:CORS_ALLOWED_ORIGINS::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/orchestryx-worker",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
